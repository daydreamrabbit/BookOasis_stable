# IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Exclude sensitive scratch and DB backups
scratch/
db/*.db.bak

# Exclude local test database and sample assets
test/

# User local docker-compose override
docker-compose.override.yml

# Logs
logs/*
!logs/.gitkeep

# 로컬 Docker 실행 데이터와 설치 플러그인
mariadb_data/
custom_fonts/
backups/
plugin_data_relay/
plugins/cache/
plugins/data/
plugins/metadata/*/

# Private operator docs (local only, not published)
docs/operator_deployment_private.md

# Thesis research data (personal, never published)
thesis_data/

# Prettier Ignore
.prettierignore

# Plugin-local runtime data (personal content, not sample fixtures).
# reading_review ships from sample_plugins/ but its runtime DB is created
# wherever it's actually installed/run from (sample folder, or plugins/metadata/
# after "install from sample") — ignore the data file in both locations.
sample_plugins/metadata/reading_review/reading_reviews.sqlite3*
plugins/metadata/reading_review/reading_reviews.sqlite3*

# Runtime state and local-only voice samples (not distribution assets).
db/*.lock
plugins/metadata/*.sqlite3*
example/ttsvoice/

# Portable Compose mount defaults: local media and rclone credentials.
rclone/
books/
comics/
